{
  "name": "lit-ui-monorepo",
  "version": "0.0.1",
  "private": true,
  "description": "A framework-agnostic component library built on Lit.js with Tailwind styling",
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:apps": "concurrently -n landing,docs -c blue,green \"pnpm --filter lit-ui-landing dev\" \"pnpm --filter lit-ui-docs dev\"",
    "build": "pnpm -r run build",
    "build:packages": "pnpm --filter './packages/**' run build",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "changeset": "changeset",
    "version": "changeset version",
    "ci:publish": "pnpm build:packages && changeset publish --access public",
    "knowledge:compile": "node --experimental-strip-types scripts/compile-knowledge.ts",
    "knowledge:render": "node --experimental-strip-types scripts/render-knowledge-image.ts",
    "knowledge:build": "pnpm run knowledge:compile && pnpm run knowledge:render"
  },
  "keywords": [
    "lit",
    "web-components",
    "tailwind",
    "ui",
    "components"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.1",
    "@changesets/cli": "^2.28.1",
    "@napi-rs/canvas": "^0.1.95",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@>=2 <3": "^2.1.6",
      "@isaacs/brace-expansion@>=5.0.0 <6.0.0": "^5.0.1",
      "browserslist@>=4.0.0 <5.0.0": "^4.28.7",
      "defu@>=6.0.0 <7.0.0": "^6.1.5",
      "js-yaml@>=3.0.0 <4.0.0": "^3.15.2",
      "js-yaml@>=4.0.0 <5.0.0": "^4.3.2",
      "lodash@>=4.0.0 <5.0.0": "^4.18.0",
      "minimatch@>=9.0.0 <10.0.0": "^9.0.7",
      "minimatch@>=10.0.0 <11.0.0": "^10.2.3",
      "nanoid@>=3.0.0 <4.0.0": "^3.3.12",
      "picomatch@>=2.0.0 <3.0.0": "^2.3.2",
      "picomatch@>=4.0.0 <5.0.0": "^4.0.4",
      "postcss@>=8.0.0 <9.0.0": "^8.5.18",
      "react-router@>=7.0.0 <8.0.0": "^7.18.2",
      "rollup@>=4.0.0 <5.0.0": "^4.59.0",
      "shell-quote@>=1.0.0 <2.0.0": "^1.9.0",
      "source-map-js@>=1.0.0 <2.0.0": "^1.2.2",
      "vitest@>=4.0.0 <5.0.0": "^4.1.0",
      "zod@>=4.0.0 <5.0.0": "^4.6.6"
    }
  }
}
